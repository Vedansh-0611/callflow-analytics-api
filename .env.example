# Copy to .env and fill in real values. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use SQLite locally. docker-compose sets this for Postgres.
# DATABASE_URL=postgres://callflow:callflow@localhost:5432/callflow

# Redis is the Celery broker and the cache that holds rate-limit counters.
# Leave unset locally to use an in-memory cache (and eager Celery, below).
# REDIS_URL=redis://localhost:6379/0
# Set to true to run tasks inline without a worker (handy for quick local dev).
CELERY_TASK_ALWAYS_EAGER=false

# Webhook signing secrets are per organization (see /api/orgs/current/webhook-secret/).
# This is how far a signed timestamp may drift from the server clock.
WEBHOOK_TOLERANCE_SECONDS=300

# JWT lifetimes for dashboard sessions.
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Comma separated origins allowed to call the API from a browser (the dashboard).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional JSON override for the LLM price table (USD per 1M tokens).
# MODEL_PRICING_JSON={"gpt-4o-mini": {"input": 0.15, "output": 0.60}}
TELEPHONY_COST_PER_MINUTE=0.010

# Rate limits (DRF format: N/sec, N/min, N/hour, N/day).
# Per-key limits come from the plan (Free 60/min, Pro 600/min). Set to override.
# API_KEY_THROTTLE_RATE=120/min
USER_THROTTLE_RATE=300/min
AUTH_THROTTLE_RATE=10/min
# Number of reverse proxies in front of the app (Render: 1), for client IPs.
NUM_PROXIES=0
WEBHOOK_MAX_BODY_BYTES=65536

# Billing provider class. The fake one switches plans with no payment.
BILLING_PROVIDER=billing.providers.FakeBillingProvider
